# Copy to .env.local and fill in. Never commit .env.local.

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# Any Postgres 13+ instance. Format:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE
#
# Local:    postgresql://postgres:postgres@localhost:5432/peoplepay360
# Neon:     postgresql://user:pass@ep-xxx.region.aws.neon.tech/peoplepay360?sslmode=require
# Supabase: postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
# Railway / Render: copy the "External Database URL" they give you
#
# SSL is enabled automatically for hosted providers and disabled for localhost.
# Force either way with ?sslmode=require or ?sslmode=disable.
#
# The database must already exist — `npm run migrate` creates tables, not the
# database itself.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/peoplepay360"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Signs the session JWT. Any long random string; changing it logs everyone out.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-something-long-and-random"

# Whether the session cookie carries the `Secure` flag.
#
# Leave this UNSET for real deployments: it then follows NODE_ENV, so anything
# built for production gets `Secure` automatically. Render, Vercel and every
# other TLS-terminating host are covered without touching this.
#
# Set it to "false" ONLY to run a production build over plain HTTP on your own
# machine (`npm run build && npm start`). Without it the browser silently
# discards the session cookie and login appears to succeed while never sticking.
#
# It is NOT derived from x-forwarded-proto on purpose. Proxies that append to a
# client-supplied value would let a caller downgrade their own session off TLS.
# COOKIE_SECURE="false"

# ---------------------------------------------------------------------------
# Demo seeding
# ---------------------------------------------------------------------------
# Shows the "Load demo data" panel on /login and enables POST /api/demo/seed.
# That endpoint is UNAUTHENTICATED by necessity — it creates the accounts you
# would need in order to sign in — so this flag is the only thing guarding it.
# Opt-in: unset means off, and only the exact string "true" counts.
# Fine for a hackathon cluster. Turn it off before anything real.
DEMO_SEED_ENABLED="false"

# ---------------------------------------------------------------------------
# Bulk payslip email (delivery module)
# ---------------------------------------------------------------------------
# Leave SMTP_HOST empty to log messages to the console instead of sending,
# which is what you want during a demo.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="PeoplePay360 <payroll@example.com>"

# ---------------------------------------------------------------------------
# Payslip archiving (AWS S3)
# ---------------------------------------------------------------------------
# OPT-IN. Leave AWS_S3_BUCKET EMPTY to turn archiving off — payslips still
# generate and download, they are simply not copied anywhere. That is the
# default and what a demo runs with; nothing else in this block is read while
# it is empty.
#
# If the bucket IS set, the rest must be too. A half-filled block throws at
# startup with a message naming what is missing, rather than failing silently
# per upload and looking identical to "archiving is off".
#
# THE BUCKET MUST BE PRIVATE. Payslips carry salary, address and bank details.
# Nothing here produces a public link: archived documents are read back through
# short-lived presigned URLs (5 minutes), minted on demand.
#
# Objects go to payslips/<payrun-id>/<payslip-id>.pdf — deterministic, so
# regenerating a payslip overwrites it rather than piling up copies, and nothing
# has to be recorded in the database to find it again.
AWS_S3_BUCKET=""
AWS_REGION="ap-south-1"

# Omit BOTH on ECS/EKS/Lambda: the SDK then picks up the instance role, your SSO
# profile, or ~/.aws/credentials by itself. Supplying only one is rejected.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# ---------------------------------------------------------------------------
# Payslip letterhead
# ---------------------------------------------------------------------------
# Printed at the top of every generated payslip. There is no companies table —
# the product is single-tenant — so the employer's identity lives here.
# Use \n inside COMPANY_ADDRESS for a multi-line address.
COMPANY_NAME="PeoplePay360"
COMPANY_ADDRESS="4th Floor, Ashram Road\nAhmedabad, Gujarat 380009\nIndia"
COMPANY_EMAIL="payroll@peoplepay360.example"
