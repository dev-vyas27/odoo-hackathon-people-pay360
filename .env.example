# Copy to .env.local and fill in. Never commit .env.local.

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# Any Postgres 13+ instance. Format:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE
#
# Local:    postgresql://postgres:postgres@localhost:5432/peoplepay360
# Neon:     postgresql://user:pass@ep-xxx.region.aws.neon.tech/peoplepay360?sslmode=require
# Supabase: postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
# Railway / Render: copy the "External Database URL" they give you
#
# SSL is enabled automatically for hosted providers and disabled for localhost.
# Force either way with ?sslmode=require or ?sslmode=disable.
#
# The database must already exist — `npm run migrate` creates tables, not the
# database itself.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/peoplepay360"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Signs the session JWT. Any long random string; changing it logs everyone out.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-something-long-and-random"

# Whether the session cookie carries the `Secure` flag.
#
# Leave this UNSET for real deployments: it then follows NODE_ENV, so anything
# built for production gets `Secure` automatically. Render, Vercel and every
# other TLS-terminating host are covered without touching this.
#
# Set it to "false" ONLY to run a production build over plain HTTP on your own
# machine (`npm run build && npm start`). Without it the browser silently
# discards the session cookie and login appears to succeed while never sticking.
#
# It is NOT derived from x-forwarded-proto on purpose. Proxies that append to a
# client-supplied value would let a caller downgrade their own session off TLS.
# COOKIE_SECURE="false"

# ---------------------------------------------------------------------------
# Demo seeding
# ---------------------------------------------------------------------------
# Shows the "Load demo data" panel on /login and enables POST /api/demo/seed.
# That endpoint is UNAUTHENTICATED by necessity — it creates the accounts you
# would need in order to sign in — so this flag is the only thing guarding it.
# Opt-in: unset means off, and only the exact string "true" counts.
# Fine for a hackathon cluster. Turn it off before anything real.
DEMO_SEED_ENABLED="false"

# ---------------------------------------------------------------------------
# Email (SMTP)
# ---------------------------------------------------------------------------
# Used for set-password invitations and, later, bulk payslip delivery.
#
# Leave SMTP_HOST EMPTY to log emails to the server console instead of sending.
# That is the right setting for a demo: the set-password link is printed in the
# terminal, and a rehearsal cannot accidentally email 25 real people.
#
# Gmail:    smtp.gmail.com : 587   (SMTP_PASSWORD must be an App Password,
#                                   not your account password — Google blocks
#                                   plain passwords. Needs 2FA enabled.)
# Outlook:  smtp-mail.outlook.com : 587
# Mailtrap: sandbox.smtp.mailtrap.io : 2525   (catches everything, sends nothing
#                                              — best for testing this flow)
# SendGrid: smtp.sendgrid.net : 587   (SMTP_USER is literally "apikey")
#
# Port 587 = STARTTLS (the usual choice). Port 465 = implicit TLS; the code
# switches automatically based on this number.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# The From: address on every email.
#
# Gmail and most providers REJECT or silently rewrite a From that is not the
# authenticated account, so this should normally match SMTP_USER.
MAIL_FROM="PeoplePay360 <your.account@gmail.com>"

# Absolute origin used to build the set-password link in invitation emails.
# Must be reachable by the recipient — localhost works only for local testing.
APP_URL="http://localhost:3000"
