# Copy to .env.local and fill in. Never commit .env.local.

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# Any Postgres 13+ instance. Format:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE
#
# Local:    postgresql://postgres:postgres@localhost:5432/peoplepay360
# Neon:     postgresql://user:pass@ep-xxx.region.aws.neon.tech/peoplepay360?sslmode=require
# Supabase: postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
# Railway / Render: copy the "External Database URL" they give you
#
# SSL is enabled automatically for hosted providers and disabled for localhost.
# Force either way with ?sslmode=require or ?sslmode=disable.
#
# The database must already exist — `npm run migrate` creates tables, not the
# database itself.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/peoplepay360"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Signs the session JWT. Any long random string; changing it logs everyone out.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-something-long-and-random"

# ---------------------------------------------------------------------------
# Demo seeding
# ---------------------------------------------------------------------------
# Shows the "Load demo data" panel on /login and enables POST /api/demo/seed.
# That endpoint is UNAUTHENTICATED by necessity — it creates the accounts you
# would need in order to sign in — so this flag is the only thing guarding it.
# Opt-in: unset means off, and only the exact string "true" counts.
# Fine for a hackathon cluster. Turn it off before anything real.
DEMO_SEED_ENABLED="false"

# ---------------------------------------------------------------------------
# Bulk payslip email (delivery module)
# ---------------------------------------------------------------------------
# Leave SMTP_HOST empty to log messages to the console instead of sending,
# which is what you want during a demo.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="PeoplePay360 <payroll@example.com>"
