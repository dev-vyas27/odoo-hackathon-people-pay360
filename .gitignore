# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code agent worktrees and local session state
.claude/
# ...but the template IS committed: it is the only record of what to set.
!.env.example

# Planning and agent scaffolding. These live on the feature branches; this one
# carries production code only.
#
# AGENTS.md in particular is REGENERATED by `next dev` (see
# node_modules/next/dist/server/lib/generate-agent-files.js), so without this
# rule it reappears on the first dev run and dirties the tree every time.
/AGENTS.md
/CLAUDE.md
/PROJECT_STRUCTURE.md
# Per-developer plans are internal scaffolding; architecture docs are not.
/docs/plans/
*.pdf
*.patch

# Playwright QA suite output
/test-results/
/playwright-report/
